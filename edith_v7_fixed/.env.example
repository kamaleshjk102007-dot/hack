# ============================================================
# E.D.I.T.H. — Environment Template (CLOUD-ONLY build)
# Copy this to .env and fill in your OWN keys.
# Never commit .env or share it.
# ============================================================

# ── Identity / Location ──────────────────────────────────────
EDITH_CITY=Bangarmau
EDITH_STATE=Uttar Pradesh
EDITH_COUNTRY=India
EDITH_LAT=27.6833
EDITH_LON=80.2167

# ── AI Backend ────────────────────────────────────────────────
EDITH_AI_BACKEND=cloud

# Google Gemini (Flash + Pro share ONE key — get at aistudio.google.com)
GOOGLE_API_KEY=
EDITH_GEMINI_MODEL=gemma-4-26b-a4b-it
EDITH_GEMINI_PRO_MODEL=gemma-4-31b-it

# Groq (console.groq.com/keys)
GROQ_API_KEY=
EDITH_GROQ_MODEL_CODE=openai/gpt-oss-120b
EDITH_GROQ_MODEL_LLAMA33=llama-3.3-70b-versatile
EDITH_GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
EDITH_GROQ_MODEL_SAFETY=openai/gpt-oss-20b
EDITH_GROQ_MODEL_QWEN=qwen/qwen3-32b

# Mistral (console.mistral.ai/api-keys)
MISTRAL_API_KEY=
EDITH_MISTRAL_MODEL=codestral-latest

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
EDITH_OPENROUTER_MODEL=openrouter/free

# Hugging Face (huggingface.co/settings/tokens)
HF_API_KEY=

# Kling (klingai.com)
KLING_API_KEY=
EDITH_KLING_API_URL=https://api-singapore.klingai.com

# Pollinations
POLLINATIONS_API_KEY=

EDITH_TEMPERATURE=0.3
EDITH_MAX_TOKENS=2048

# ── Voice ─────────────────────────────────────────────────────
EDITH_TTS_ENGINE=pyttsx3
EDITH_STT_ENGINE=none

# ── Email (Phase 9) ───────────────────────────────────────────
GMAIL_USER=
GMAIL_PASSWORD=

# ── HUD Server ────────────────────────────────────────────────
EDITH_HUD_PORT=5000
# HUD host binding: Defaults to loopback 127.0.0.1 for local-only security.
# To expose HUD to other devices on the LAN, explicitly set EDITH_HUD_HOST=0.0.0.0
# AND EDITH_ALLOW_REMOTE_HUD=true.
EDITH_HUD_HOST=127.0.0.1
EDITH_ALLOW_REMOTE_HUD=false
VT_API_KEY=your_virustotal_api_key