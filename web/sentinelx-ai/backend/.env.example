# SYNTRAX AI — Gemma 4 Threat Investigation Gateway
# Environment Configuration Template
# IMPORTANT: Never commit actual API keys to version control.

# Local Gateway Port (Default: 8787)
PORT=8787

# Official Google AI Studio / Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Official Model Identifier
# Supported Gemma Models: gemma-4-31b-it, gemma-4-26b-a4b-it
# Gemini Fallback: gemini-2.0-flash, gemini-1.5-flash
GEMMA_MODEL_ID=gemma-4-31b-it

# Gateway Request Timeout (in milliseconds)
REQUEST_TIMEOUT_MS=10000

# VirusTotal API v3 (Optional External Threat Intelligence)
# Obtain from: https://www.virustotal.com/gui/my-apikey
# Free tier allows 4 lookups/min, 500/day.
VT_API_KEY=
VT_ENABLED=true
